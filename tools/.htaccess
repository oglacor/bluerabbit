# Nothing in this directory is ever served over HTTP.
#
# These are CLI maintenance tools. loadtest.php mints valid WordPress auth cookies
# for arbitrary players, so if it were ever reachable and its CLI guard were ever
# bypassed, it would hand out working sessions. The guard inside each file is the
# real lock; this is the second one.
#
# Note for nginx: .htaccess does nothing there. On nginx either exclude this
# directory from deployment or add
#     location ~ ^/wp-content/themes/bluerabbit/tools/ { deny all; }
# Output files are written outside the document root regardless, so a missing rule
# here does not expose captured data.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
